// Prisma 7: the connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API compiles to CommonJS. Without these two, the generated client uses
  // `import.meta.url` and `.ts`-extension imports, neither of which tsc can emit
  // to CommonJS.
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  // citext gives case-insensitive uniqueness in the database itself, so no code
  // path can bypass it by forgetting to lowercase. Trusted extension since PG13,
  // so the non-superuser app role can install it.
  email String @unique @db.Citext
  name  String

  // argon2id PHC string. Non-nullable: an account without a credential has no
  // defined meaning today, and allowing null would force every auth path to
  // handle it forever.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer         Trainer?
  sessions        Session[]
  teamMemberships TeamMember[]
  clientProfiles  Client[]

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  NUTRITIONIST
}

enum ClientStatus {
  INVITED
  ACTIVE
  ARCHIVED
}

/// Which hat a session was issued for. Stored on the row rather than derived
/// per request: a user may be both a trainer and someone's client, and deriving
/// would make every request guess — an ambiguous principal and an escalation
/// path. A CLIENT token stays a CLIENT token no matter what the user becomes.
enum SessionContext {
  TRAINER
  CLIENT
}

/// Server-side session. The cookie carries a random token; only its SHA-256
/// lives here, so a database leak yields no usable sessions. Deleting the row
/// revokes the session immediately — the reason we chose this over a stateless
/// JWT, given the guard already loads the tenant from the database anyway.
///
/// CLIENT sessions bind to one Client row at issue time, which fixes the tenant
/// exactly and leaves multi-trainer switching open: a new session per tenant.
/// The migration adds a CHECK enforcing context=CLIENT ⇔ clientId set.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  context SessionContext

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([clientId])
}

model Trainer {
  id String @id @default(cuid())

  // @unique already creates the index on userId; a separate @@index would be a
  // redundant second index on the same column.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String

  /// What this trainer's own CLIENTS see instead of Gart's name.
  brandName String?

  /// The stored logo, as a storage KEY rather than a URL.
  ///
  /// A key and not a URL because a URL would be somebody else's host embedded
  /// in our page — hotlinked, unverifiable, and outside every check the media
  /// path performs. The key is server-generated, so its random segment changes
  /// on every upload, which is what lets the serving route cache immutably.
  brandLogoKey String?

  /// The verified content type of the stored logo.
  ///
  /// Recorded at finalize, exactly as ProgressPhoto and ExerciseMedia record
  /// theirs, so serving the logo costs ONE storage round trip rather than two —
  /// this is the only unauthenticated byte-serving route in the app, and asking
  /// storage twice per request doubles its cost for nothing. It is also the
  /// verified value rather than a re-derived one, so a later change to the
  /// media-type table cannot retroactively change what an old logo claims to be.
  brandLogoType String?

  /// An arbitrary trainer-chosen colour, and therefore DECORATIVE ONLY.
  ///
  /// It cannot be contrast-verified — the trainer picks it, not us — so it is
  /// never allowed to carry text or to become a background that text sits on.
  /// Stored strictly as `#RRGGBB`: the value reaches a CSS `style` attribute,
  /// and the only safe policy for that is an exact-shape allowlist.
  brandColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers TeamMember[]
  clients     Client[]
  invites     ClientInvite[]
  exercises   Exercise[]
  categories  Category[]
  programs    Program[]
  assignments Assignment[]
  workoutLogs WorkoutLog[]

  progressVariables ProgressVariable[]
  progressPhotos    ProgressPhoto[]
  habits            Habit[]
  notifications     Notification[]
  chatThreads       ChatThread[]
  payments          Payment[]
  subscription      Subscription?
  foods             Food[]
}

/// The anatomical vocabulary. A closed set trainers do not extend, so an enum
/// rather than a table: no joins, no seed prerequisite, filterable with `has`.
/// Ukrainian labels live in @gart/shared (MUSCLE_GROUP_LABELS), the same split
/// as ClientStatus and its labels. Extending later is one additive migration.
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS
  GLUTES
  CORE
  CALVES
  FULL_BODY
}

/// An exercise in the library. `trainerId` NULL means the global base library,
/// visible to every trainer and mutable by none — writes go through a where
/// clause that matches the caller's own trainerId, which a NULL row can never
/// satisfy. A set trainerId is one trainer's custom exercise, invisible to the
/// rest.
model Exercise {
  id String @id @default(cuid())

  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name        String
  description String?

  primaryMuscleGroup MuscleGroup
  /// Secondary groups; the primary is not repeated here.
  muscleGroups       MuscleGroup[]

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  textInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media               ExerciseMedia[]
  programExercises    ProgramExercise[]
  assignmentExercises AssignmentExercise[]

  @@index([trainerId])
}

enum MediaKind {
  VIDEO
  AUDIO
}

/// One stored rendition of an exercise's media. Ownership is not duplicated
/// here: media belongs to its exercise, and every access path goes through the
/// exercise's own visibleTo/requireOwned gates.
///
/// `storageKey` names a private object — the bucket has no public access, and
/// the key never crosses the wire except in the presign response that created
/// it. Serving happens via short-lived presigned GETs minted per request.
model ExerciseMedia {
  id String @id @default(cuid())

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  kind        MediaKind
  storageKey  String    @unique
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime  @default(now())

  // One rendition per kind; doubles as the exerciseId lookup index.
  @@unique([exerciseId, kind])
}

/// Exercise grouping (Сила, Кардіо…). Same global-vs-custom split as Exercise,
/// but trainers create their own, so it is a table with CRUD rather than an
/// enum. Postgres treats NULLs as distinct in unique indexes, so the constraint
/// below governs each trainer's names only; global rows are written solely by
/// the idempotent seed, which enforces their uniqueness itself.
model Category {
  id String @id @default(cuid())

  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises Exercise[]

  // Doubles as the trainerId index: its leading column is trainerId.
  @@unique([trainerId, name])
}

/// What a food is, coarsely. A closed set trainers do not extend, so an enum
/// rather than a table — the same call MuscleGroup makes: no joins, no seed
/// prerequisite, filterable. Ukrainian labels live in @gart/shared.
enum FoodGroup {
  GRAINS
  MEAT
  FISH
  DAIRY
  EGGS
  VEGETABLES
  FRUIT
  NUTS_SEEDS
  LEGUMES
  FATS_OILS
  BAKERY
  SWEETS
  BEVERAGES
  SAUCES
  OTHER
}

/// One entry in the food library.
///
/// Ownership is the exercise library's, unchanged: a NULL trainerId is a global
/// row every trainer can read, and writes go through `{ id, trainerId }`, which
/// a NULL can never match. Globals are immutable by construction, with no
/// "if global" branch anywhere to forget.
///
/// Every value is PER 100 GRAMS, always, so nothing downstream has to ask «per
/// what?» — portions convert, they do not redefine the basis.
model Food {
  id String @id @default(cuid())

  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name  String
  brand String?
  group FoodGroup

  /// Decimal, never float. These are multiplied by portion weights and summed
  /// across a day's meals, so an error at 100 g compounds — the same argument
  /// that keeps money out of floating point.
  kcal    Decimal @db.Decimal(7, 2)
  protein Decimal @db.Decimal(6, 2)
  fat     Decimal @db.Decimal(6, 2)
  carbs   Decimal @db.Decimal(6, 2)

  /// NULL means NOT MEASURED, which is not the same as zero.
  fibre        Decimal? @db.Decimal(6, 2)
  sugars       Decimal? @db.Decimal(6, 2)
  saturatedFat Decimal? @db.Decimal(6, 2)
  /// Two places like every other nutrient, so the arithmetic has one scale.
  /// EU labels quote salt to two decimals, and 0.01 g is 10 mg — finer than
  /// anybody plans a meal to.
  salt         Decimal? @db.Decimal(6, 2)

  /// Where these numbers came from. A food catalogue without provenance is a
  /// set of assertions; global rows name their database, a trainer's own say
  /// so plainly rather than borrowing an authority.
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portions FoodPortion[]

  @@index([trainerId])
}

/// A named measure of a food, and what it actually weighs.
///
/// Ownership is NOT duplicated here: a portion belongs to its food, and every
/// path to it goes through that food's own visibleTo/requireOwned gates —
/// exactly as ExerciseMedia belongs to its exercise.
model FoodPortion {
  id String @id @default(cuid())

  foodId String
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  label String
  grams Decimal @db.Decimal(7, 2)

  createdAt DateTime @default(now())

  @@unique([foodId, label])
}

/// A user acting inside a trainer's account. The OWNER row is created alongside
/// the trainer at registration, so a tenant always has exactly one owner.
model TeamMember {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TeamRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Also serves as the trainerId index: its leading column is trainerId.
  @@unique([trainerId, userId])
}

/// A person a trainer coaches. Exists before they have an account — `userId` is
/// filled in when they accept their invite.
model Client {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName String
  email    String @db.Citext

  status    ClientStatus @default(INVITED)
  invitedAt DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invites     ClientInvite[]
  sessions    Session[]
  assignments Assignment[]
  workoutLogs WorkoutLog[]

  progressVariables ProgressVariable[]
  progressPhotos    ProgressPhoto[]
  habits            Habit[]
  notifications     Notification[]
  chatThreads       ChatThread[]

  // One row per person per trainer. The same address may belong to a different
  // trainer's client — a person can train with more than one coach.
  // Doubles as the trainerId index.
  @@unique([trainerId, email])
  @@index([userId])
}

/// A one-time link letting a client set their password. As with sessions, only
/// the SHA-256 of the token is stored; the raw token exists solely in the link
/// handed to the trainer once.
model ClientInvite {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId])
}

/// One vocabulary for both levels: Program.type is the headline (and Step 11's
/// default for new sections); ProgramSection.type is what actually governs
/// execution, so one session can mix a strength warm-up with an AMRAP finisher.
enum WorkoutType {
  STRENGTH
  RUNNING
  AMRAP
  EMOM
  CIRCUIT
  CUSTOM
}

enum LoadUnit {
  KG
  PERCENT_1RM
  RPE
}

/// A trainer's program template. No client link — Step 12's Assignment will
/// snapshot a template rather than reference this live tree, which is also why
/// tree updates may replace rows wholesale: nothing durable ever hangs off
/// section or line ids.
model Program {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  type        WorkoutType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections    ProgramSection[]
  assignments Assignment[]

  @@index([trainerId])
}

/// An ordered block of a program. The four structure fields are the entire
/// type-specific vocabulary; which are required or forbidden per type is
/// enforced by program-rules.ts, not by the schema — but order uniqueness is.
model ProgramSection {
  id String @id @default(cuid())

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  name  String?
  type  WorkoutType
  order Int

  timeCapSeconds           Int?
  intervalSeconds          Int?
  rounds                   Int?
  restBetweenRoundsSeconds Int?

  exercises ProgramExercise[]

  // The array position of the payload is the only source of order; this backstop
  // guarantees no duplicates survive a write. Doubles as the ordered-read index.
  @@unique([programId, order])
}

/// One prescribed line. Prescription fields are deliberately all optional —
/// structure is validated, methodology is not legislated: a strength section
/// legitimately holds a 40-second plank. Load is either a number with a unit or
/// free text, never both (cross-validated at the boundary).
model ProgramExercise {
  id String @id @default(cuid())

  sectionId String
  section   ProgramSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Restrict settles the Step 7 contract: deleting an exercise that a program
  // still references is refused, and the endpoint maps it to a 409.
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  order Int

  sets Int?
  reps Int?

  loadValue Decimal?  @db.Decimal(6, 2)
  loadUnit  LoadUnit?
  loadText  String?

  restSeconds Int?
  tempo       String?
  notes       String?

  durationSeconds Int?
  distanceMeters  Int?

  @@unique([sectionId, order])
  @@index([exerciseId])
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// A program assigned to a client — as an independent SNAPSHOT, the invariant
/// Steps 10–11 designed toward. The tree below (AssignmentSection/-Exercise) is
/// written once in the assign transaction and has no update path at all:
/// editing or deleting the source template cannot reach it by construction.
/// `sourceProgramId` is provenance only — never read for the tree — and goes
/// NULL when the template is deleted.
///
/// Schedule is weekly recurrence: startDate, optional endDate, ISO weekdays
/// (Пн=1). Step 13's «today» is one query; Step 14 addresses an occurrence as
/// (assignmentExerciseId, date).
model Assignment {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sourceProgramId String?
  sourceProgram   Program? @relation(fields: [sourceProgramId], references: [id], onDelete: SetNull)

  name        String
  description String?
  type        WorkoutType

  status AssignmentStatus @default(ACTIVE)

  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  daysOfWeek Int[]

  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sections AssignmentSection[]

  @@index([trainerId])
  @@index([clientId])
}

model AssignmentSection {
  id String @id @default(cuid())

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  name  String?
  type  WorkoutType
  order Int

  timeCapSeconds           Int?
  intervalSeconds          Int?
  rounds                   Int?
  restBetweenRoundsSeconds Int?

  exercises AssignmentExercise[]

  @@unique([assignmentId, order])
}

/// One frozen prescription line. Unlike template rows, this id is durable —
/// Step 14's WorkoutLog references it as a real foreign key. The prescription
/// is snapshotted; the exercise itself stays a live library reference (name,
/// instructions, video should show the trainer's latest fixes), protected by
/// Restrict exactly like template references.
model AssignmentExercise {
  id String @id @default(cuid())

  sectionId String
  section   AssignmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  order Int

  sets Int?
  reps Int?

  loadValue Decimal?  @db.Decimal(6, 2)
  loadUnit  LoadUnit?
  loadText  String?

  restSeconds Int?
  tempo       String?
  notes       String?

  durationSeconds Int?
  distanceMeters  Int?

  logs WorkoutLog[]

  @@unique([sectionId, order])
  @@index([exerciseId])
}

/// What the client actually did, for one snapshot exercise on one date.
///
/// The prescription is frozen and this table never touches it: logging only
/// ever READS `AssignmentExercise` (to gate ownership and prefill defaults), so
/// planned and actual can never contaminate each other.
///
/// `@@unique([assignmentExerciseId, date])` puts the upsert invariant in the
/// database: editing today's record updates it, and no retried request can
/// double-count volume in Phase 2's charts. `trainerId`/`clientId` are
/// denormalised from the parent assignment, where both are immutable (PATCH
/// whitelists schedule and status), so they cannot drift — and Step 15's
/// trainer queries get an index instead of a three-table join.
model WorkoutLog {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  assignmentExerciseId String
  assignmentExercise   AssignmentExercise @relation(fields: [assignmentExerciseId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  /// false is a deliberate record — «I skipped this», with the reason in notes.
  completed Boolean
  notes     String?

  sets WorkoutSetLog[]

  loggedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentExerciseId, date])
  @@index([clientId, date])
  @@index([trainerId, date])
}

/// One actual set. Load is always kilograms: %1ПМ and RPE are prescription
/// languages for choosing a weight, while this records the weight actually
/// moved — one unit keeps Phase 2's volume math correct without unit-aware
/// aggregation, and keeps the load XOR rule out of the actuals entirely.
model WorkoutSetLog {
  id String @id @default(cuid())

  logId String
  log   WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)

  order Int

  reps            Int?
  loadKg          Decimal? @db.Decimal(6, 2)
  durationSeconds Int?
  distanceMeters  Int?

  @@unique([logId, order])
}

/// A dimension the trainer tracks for ONE client — «Вага», «Обхват талії»,
/// «% жиру», or anything their method calls for.
///
/// Per client rather than a trainer-level template with assignments: a trainer
/// tracks a handful of dimensions per person and *which* ones is itself a
/// coaching decision, so one table with no assignment lifecycle says the same
/// thing without the template-versus-instance questions (what a rename means
/// for history, what unassigning does to past entries). Retyping a custom name
/// is softened by suggestions, not by a second table.
///
/// `unit` is a free display label, and that does not contradict the load
/// lesson from programs — there it was the VALUE that had to escape free text.
/// The value below is always numeric; the unit is never read by a chart, so
/// constraining it would only stop a trainer tracking «год сну».
model ProgressVariable {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name String
  unit String

  /// Whether the client may record this one themselves. Off by default: entries
  /// upsert per date, so an open variable lets a client's own reading replace
  /// the trainer's measurement for that day — a decision the trainer makes.
  selfLog Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries ProgressEntry[]

  @@unique([clientId, name])
  @@index([trainerId])
}

/// One measurement on one date.
///
/// `@@unique([variableId, date])` makes it an upsert, for the same reason
/// workout logs are: a measurement is a fact about a date, not an event
/// stream. Re-measuring corrects the value; appending would force «latest
/// wins» on every read and let a retried request bend a chart. The unique
/// index is also the longitudinal index — variableId leads, date follows — so
/// a series is one ordered range scan.
///
/// Decimal, never float: a chart of 84.10 → 83.95 must not drift.
model ProgressEntry {
  id String @id @default(cuid())

  variableId String
  variable   ProgressVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  value Decimal  @db.Decimal(8, 2)
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variableId, date])
}

/// A progress photo — private media, the same model exercise media uses: the
/// bucket has no public access, `storageKey` never crosses the wire, and
/// viewing mints a short-lived presigned GET per request for the owning
/// trainer or that client alone. These are more sensitive than exercise clips,
/// which is exactly why they reuse that path rather than a new one.
model ProgressPhoto {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  label String?

  storageKey  String @unique
  contentType String
  sizeBytes   Int

  uploadedAt DateTime @default(now())

  @@index([clientId, date])
  @@index([trainerId])
}

/// How the client is ASKED, not how the habit is stored: a checkbox or a
/// number. Storage is uniform either way — see Habit.targetValue.
enum HabitKind {
  CHECK
  AMOUNT
}

/// A daily habit the trainer set for one client — вода, кроки, сон.
///
/// A boolean habit is not a special case in storage: it is simply a target of
/// 1. That keeps ONE comparison — `value >= targetValue` — deciding whether a
/// day counts, so streaks, day strips and adherence never branch on kind, and
/// «checkbox habit with a target of 8» cannot be represented at all.
///
/// Per client rather than a trainer-level template, for the same reason
/// progress variables are: which habits someone works on is a coaching
/// decision, not a catalogue to assign.
model Habit {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name String
  kind HabitKind

  targetValue Decimal @db.Decimal(8, 2)

  /// AMOUNT only — «склянок», «кроків», «год». A checkbox habit has no unit,
  /// and that is what the null means.
  unit String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs HabitLog[]

  @@unique([clientId, name])
  @@index([trainerId])
}

/// One day of one habit.
///
/// Upserted on (habit, date) for the third time in this codebase and for the
/// same reason: a day is a fact, not an event stream. There is no explicit
/// zero — untapping DELETES the row, so «нічого не записано» and «записав
/// нуль» never become two states nobody can tell apart. A partial amount (5 of
/// 8) is real data: recorded, shown, and simply not counted toward a streak.
model HabitLog {
  id String @id @default(cuid())

  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)

  date  DateTime @db.Date
  value Decimal  @db.Decimal(8, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
}

/// Which app shows a notification. Stored rather than derived because one
/// person can be both a trainer and someone's client — the same fact that made
/// Session.context a column: a client-side notification must never surface in
/// the trainer app.
enum NotificationAudience {
  TRAINER
  CLIENT
}

enum NotificationType {
  WORKOUT_LOGGED
  EXERCISE_SKIPPED
  PROGRESS_LOGGED
  HABIT_STREAK
  ASSIGNMENT_CREATED
  CLIENT_INACTIVE
  TRAINER_MESSAGE
  CHAT_MESSAGE
  SUBSCRIPTION_PAST_DUE
  SUBSCRIPTION_ENDED
}

/// One thing that happened and somebody may care about.
///
/// The trainer's activity feed IS this list: «client X did Y» is exactly what
/// a notification is for them, so a second table would only duplicate
/// emission, read state, scoping and paging.
///
/// `userId` exists for DELIVERY (push subscriptions are per user) and is never
/// the read scope. Reads are scoped by the hat the session wears: a trainer by
/// `{ trainerId, audience: TRAINER }`, a client by `{ clientId, audience:
/// CLIENT }` — the per-(trainer, client) rule Step 16 settled.
model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  /// The client the notification concerns (trainer feed) or belongs to.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  audience NotificationAudience
  type     NotificationType

  /// Composed in Ukrainian at emission — explicit columns rather than a JSON
  /// blob, matching how every other wire shape in this codebase is built.
  title String
  body  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([trainerId, audience, createdAt])
  @@index([clientId, createdAt])
  @@index([userId])
}

/// One browser (or installed PWA) that agreed to receive push.
///
/// Belongs to a USER rather than a tenant: the same person may hold both hats
/// on one device, and the subscription is the device's, not the role's.
/// Pruned when the push service reports it gone (404/410) — and only then; a
/// 500 is transient and must not destroy a working subscription.
model PushSubscription {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Which side of a conversation spoke. A message belongs to a side rather than
/// to a user id: both participants are already pinned by the thread, and the
/// hat someone wears is the concept this codebase has used since Step 6.
enum ChatRole {
  TRAINER
  CLIENT
}

/// Exactly one conversation per (trainer, client) — the unique constraint IS
/// the participant list, because 1:1 is the whole feature. Group chats, when
/// they come, are a different shape rather than a longer list here.
///
/// Read state is one timestamp per side: unread means «after my lastReadAt and
/// not sent by me», which is all a badge needs. Per-message delivery and read
/// ticks would need a row per message per participant, and nobody has asked.
model ChatThread {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  trainerLastReadAt DateTime?
  clientLastReadAt  DateTime?

  /// Denormalised for ordering threads and for «is there anything new» without
  /// counting rows.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@unique([trainerId, clientId])
  @@index([trainerId, lastMessageAt])
}

model ChatMessage {
  id String @id @default(cuid())

  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderRole ChatRole

  /// Empty when the message is pure media. A message must carry text or an
  /// attachment — the rule lives in one place server-side, the way section and
  /// habit rules do, rather than as a nullable column nobody can interpret.
  body String @default("")

  createdAt DateTime @default(now())

  attachment ChatAttachment?

  @@index([threadId, createdAt])
}

enum ChatAttachmentKind {
  VOICE
  IMAGE
  VIDEO
}

/// Media carried by a message — private, exactly like exercise media and
/// progress photos, and on the same path: presigned direct upload, magic-byte
/// verification before the row exists, and a presigned GET minted per view for
/// the two people in the conversation and nobody else.
///
/// Its own table rather than nullable columns on the message: the attachment's
/// existence is the discriminator, and every column here is non-null because
/// an attachment that exists always has all of them.
model ChatAttachment {
  id String @id @default(cuid())

  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  kind ChatAttachmentKind

  storageKey  String @unique
  contentType String
  sizeBytes   Int

  /// Client-reported, so a player can show a length before loading anything.
  /// Bounded on the way in and never trusted for anything that matters.
  durationSeconds Int?

  createdAt DateTime @default(now())
}

/// Prices are money, so Decimal — never Float. Step 10 settled that for
/// progress values; here the stakes are a bank transfer rather than a chart.
enum Currency {
  UAH
}

/// What a trainer subscribes to: Gart's own tiers.
///
/// The platform's only revenue is the trainer's subscription to it. Money never
/// flows between a client and their trainer through this system — they settle
/// that between themselves, and Gart knows nothing about it.
enum SubscriptionPlan {
  PRO
  GROW
  SCALE
}

/// Counted in months rather than days so a renewal lands on a month boundary.
enum SubscriptionPeriod {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

/// The canonical lifecycle. Each provider's own vocabulary — LiqPay's
/// `wait_accept`, Fondy's `approved`, WayForPay's `Approved` — is mapped onto
/// exactly these four inside the provider adapter, so nothing downstream ever
/// learns which acquirer is behind the seam.
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

/// One attempt to collect a trainer's subscription fee.
///
/// `id` doubles as the order reference handed to the provider — LiqPay's
/// `order_id`, Fondy's `order_id`, WayForPay's `orderReference` all require a
/// merchant-owned unique value, and reusing the primary key means the provider
/// deduplicates on exactly the value we deduplicate on.
///
/// `amount` is a SNAPSHOT of the plan price at the time of the charge, never a
/// lookup: a price change must not retroactively alter what was billed.
model Payment {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  amount   Decimal  @db.Decimal(12, 2)
  currency Currency

  status PaymentStatus @default(PENDING)

  /// Which adapter produced this row, so a later multi-provider world stays
  /// legible and reconciliation knows who to ask.
  provider String
  /// The provider's own identifier, once it has told us one.
  providerRef String?
  /// The provider's own status word, kept verbatim for audit and support.
  providerStatus String?

  /// The provider's handle on the mandate this payment established, when it
  /// established one. Carried here because the provider returns it with the
  /// session — before the callback that settles it — and the subscription needs
  /// it to charge against later.
  recurrenceRef String?

  /// What the payer was shown, snapshotted.
  description String

  /// The subscription period this payment is for.
  ///
  /// The triple below is unique, which is what makes a re-run of the renewal
  /// job a no-op rather than a second charge: two workers racing the same due
  /// subscription both try to insert the same (subscription, period, attempt),
  /// and Postgres lets exactly one of them win.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  periodStart    DateTime?
  /// Which attempt at this period this payment is — 1 for the first charge, 2
  /// for the first dunning retry, and so on.
  ///
  /// Part of the key because a RETRY is a legitimate second charge for the same
  /// period, and keying on the period alone would have made the guard refuse the
  /// dunning schedule it exists alongside. One charge per attempt is the
  /// invariant that actually holds.
  periodAttempt Int?

  /// What this payment bought, frozen at the time of the charge.
  ///
  /// The PAYMENT is the authority on the arrangement it paid for, not the
  /// subscription row. The row can move between a charge being raised and its
  /// callback arriving — a cadence change, an abandoned checkout for different
  /// terms — and reading the arrangement back off it at settlement would let
  /// the money taken and the access granted describe different things.
  planSnapshot   SubscriptionPlan?
  periodSnapshot SubscriptionPeriod?

  paidAt   DateTime?
  failedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events PaymentEvent[]

  /// Null refs never collide in Postgres, so many PENDING rows coexist while a
  /// settled reference stays unique to one payment.
  @@unique([provider, providerRef])
  @@unique([subscriptionId, periodStart, periodAttempt])
  @@index([trainerId, status])
}

/// Append-only: every callback delivery ever accepted, in the provider's own
/// words. The audit trail behind "why does this subscription say it is paid?".
///
/// `externalId` is the provider's identifier for THIS DELIVERY, not for the
/// payment. Providers that do not supply one get a digest of the canonical
/// payload, so a byte-identical retry collides with its own first attempt.
model PaymentEvent {
  id String @id @default(cuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  externalId String
  status     PaymentStatus
  /// The provider's own status word for this delivery.
  rawStatus String

  /// SHA-256 of the raw body. Enough to prove what arrived without keeping a
  /// payload that may carry payer details we have no reason to store.
  payloadDigest String

  receivedAt DateTime @default(now())

  /// A replayed delivery is rejected by Postgres, not by a service-level check
  /// that a race could slip past.
  @@unique([paymentId, externalId])
  @@index([paymentId])
}

/// Where a subscription stands. ACTIVE and PAST_DUE both still have access —
/// PAST_DUE is a charge that failed and is being retried, not a closed door.
enum SubscriptionStatus {
  /// A free trial: live access, no card taken, and nothing will be charged when
  /// it runs out. Distinct from ACTIVE because the UI has to be able to say
  /// which one somebody is in, and when it ends.
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  ENDED
}

/// A trainer's subscription to Gart.
///
/// The division of labour this model rests on: a PAYMENT is the audit ledger —
/// one immutable row per charge, never rewritten. A SUBSCRIPTION is the
/// current-state head: where things stand now, and what happens next.
model Subscription {
  id String @id @default(cuid())

  /// One Gart subscription per trainer. A trainer who resubscribes after theirs
  /// ended reuses this row; what they paid lives in the Payments that
  /// reference it.
  trainerId String  @unique
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  /// Which tier, snapshotted: changing plans is a decision, not a drift.
  plan SubscriptionPlan

  status SubscriptionStatus @default(ACTIVE)

  period SubscriptionPeriod

  /// A cadence change the trainer has asked for, applied at the next renewal.
  ///
  /// Changes land on the boundary rather than immediately: the period already
  /// paid for runs on the terms it was bought under, so no money moves and
  /// there is no proration to get wrong or partial refund to argue about.
  pendingPeriod SubscriptionPeriod?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  /// The day of the month this subscription bills on, kept so the clamp is
  /// applied to the ANCHOR rather than to the previous clamped date.
  ///
  /// Without it the anniversary can only ratchet downward: 31 January clamps to
  /// 28 February, and computing the next period from the 28th gives 28 March
  /// instead of the 31st, for ever.
  anchorDay Int

  /// The authority for access, and deliberately not derived from a payment.
  ///
  /// A payment records what was BOUGHT. Dunning grace was not bought, so it
  /// cannot honestly be expressed as one. This column says how long the
  /// workspace actually runs, including grace.
  accessUntil DateTime

  /// When the next charge is attempted. Null once nothing further is due —
  /// cancelled, or ended.
  nextChargeAt DateTime?

  /// Consecutive failures for the CURRENT period. Cleared by any success.
  failedAttempts Int @default(0)

  /// The provider's handle on the mandate, for charges with no payer present.
  recurrenceRef String?

  cancelledAt DateTime?
  endedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  /// The renewal job's whole query: what is due, and when.
  @@index([status, nextChargeAt])
}
