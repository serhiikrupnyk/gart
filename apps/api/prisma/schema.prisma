// Prisma 7: the connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The API compiles to CommonJS. Without these two, the generated client uses
  // `import.meta.url` and `.ts`-extension imports, neither of which tsc can emit
  // to CommonJS.
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  // citext gives case-insensitive uniqueness in the database itself, so no code
  // path can bypass it by forgetting to lowercase. Trusted extension since PG13,
  // so the non-superuser app role can install it.
  email String @unique @db.Citext
  name  String

  // argon2id PHC string. Non-nullable: an account without a credential has no
  // defined meaning today, and allowing null would force every auth path to
  // handle it forever.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer         Trainer?
  sessions        Session[]
  teamMemberships TeamMember[]
  clientProfiles  Client[]
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  NUTRITIONIST
}

enum ClientStatus {
  INVITED
  ACTIVE
  ARCHIVED
}

/// Which hat a session was issued for. Stored on the row rather than derived
/// per request: a user may be both a trainer and someone's client, and deriving
/// would make every request guess — an ambiguous principal and an escalation
/// path. A CLIENT token stays a CLIENT token no matter what the user becomes.
enum SessionContext {
  TRAINER
  CLIENT
}

/// Server-side session. The cookie carries a random token; only its SHA-256
/// lives here, so a database leak yields no usable sessions. Deleting the row
/// revokes the session immediately — the reason we chose this over a stateless
/// JWT, given the guard already loads the tenant from the database anyway.
///
/// CLIENT sessions bind to one Client row at issue time, which fixes the tenant
/// exactly and leaves multi-trainer switching open: a new session per tenant.
/// The migration adds a CHECK enforcing context=CLIENT ⇔ clientId set.
model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  context SessionContext

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([clientId])
}

model Trainer {
  id String @id @default(cuid())

  // @unique already creates the index on userId; a separate @@index would be a
  // redundant second index on the same column.
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName  String
  brandName    String?
  brandLogoUrl String?
  brandColor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamMembers TeamMember[]
  clients     Client[]
  invites     ClientInvite[]
  exercises   Exercise[]
  categories  Category[]
  programs    Program[]
  assignments Assignment[]
}

/// The anatomical vocabulary. A closed set trainers do not extend, so an enum
/// rather than a table: no joins, no seed prerequisite, filterable with `has`.
/// Ukrainian labels live in @gart/shared (MUSCLE_GROUP_LABELS), the same split
/// as ClientStatus and its labels. Extending later is one additive migration.
enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  ARMS
  LEGS
  GLUTES
  CORE
  CALVES
  FULL_BODY
}

/// An exercise in the library. `trainerId` NULL means the global base library,
/// visible to every trainer and mutable by none — writes go through a where
/// clause that matches the caller's own trainerId, which a NULL row can never
/// satisfy. A set trainerId is one trainer's custom exercise, invisible to the
/// rest.
model Exercise {
  id String @id @default(cuid())

  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name        String
  description String?

  primaryMuscleGroup MuscleGroup
  /// Secondary groups; the primary is not repeated here.
  muscleGroups       MuscleGroup[]

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  textInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media               ExerciseMedia[]
  programExercises    ProgramExercise[]
  assignmentExercises AssignmentExercise[]

  @@index([trainerId])
}

enum MediaKind {
  VIDEO
  AUDIO
}

/// One stored rendition of an exercise's media. Ownership is not duplicated
/// here: media belongs to its exercise, and every access path goes through the
/// exercise's own visibleTo/requireOwned gates.
///
/// `storageKey` names a private object — the bucket has no public access, and
/// the key never crosses the wire except in the presign response that created
/// it. Serving happens via short-lived presigned GETs minted per request.
model ExerciseMedia {
  id String @id @default(cuid())

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  kind        MediaKind
  storageKey  String    @unique
  contentType String
  sizeBytes   Int
  uploadedAt  DateTime  @default(now())

  // One rendition per kind; doubles as the exerciseId lookup index.
  @@unique([exerciseId, kind])
}

/// Exercise grouping (Сила, Кардіо…). Same global-vs-custom split as Exercise,
/// but trainers create their own, so it is a table with CRUD rather than an
/// enum. Postgres treats NULLs as distinct in unique indexes, so the constraint
/// below governs each trainer's names only; global rows are written solely by
/// the idempotent seed, which enforces their uniqueness itself.
model Category {
  id String @id @default(cuid())

  trainerId String?
  trainer   Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises Exercise[]

  // Doubles as the trainerId index: its leading column is trainerId.
  @@unique([trainerId, name])
}

/// A user acting inside a trainer's account. The OWNER row is created alongside
/// the trainer at registration, so a tenant always has exactly one owner.
model TeamMember {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role TeamRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Also serves as the trainerId index: its leading column is trainerId.
  @@unique([trainerId, userId])
}

/// A person a trainer coaches. Exists before they have an account — `userId` is
/// filled in when they accept their invite.
model Client {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName String
  email    String @db.Citext

  status    ClientStatus @default(INVITED)
  invitedAt DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invites     ClientInvite[]
  sessions    Session[]
  assignments Assignment[]

  // One row per person per trainer. The same address may belong to a different
  // trainer's client — a person can train with more than one coach.
  // Doubles as the trainerId index.
  @@unique([trainerId, email])
  @@index([userId])
}

/// A one-time link letting a client set their password. As with sessions, only
/// the SHA-256 of the token is stored; the raw token exists solely in the link
/// handed to the trainer once.
model ClientInvite {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([clientId])
}

/// One vocabulary for both levels: Program.type is the headline (and Step 11's
/// default for new sections); ProgramSection.type is what actually governs
/// execution, so one session can mix a strength warm-up with an AMRAP finisher.
enum WorkoutType {
  STRENGTH
  RUNNING
  AMRAP
  EMOM
  CIRCUIT
  CUSTOM
}

enum LoadUnit {
  KG
  PERCENT_1RM
  RPE
}

/// A trainer's program template. No client link — Step 12's Assignment will
/// snapshot a template rather than reference this live tree, which is also why
/// tree updates may replace rows wholesale: nothing durable ever hangs off
/// section or line ids.
model Program {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  type        WorkoutType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections    ProgramSection[]
  assignments Assignment[]

  @@index([trainerId])
}

/// An ordered block of a program. The four structure fields are the entire
/// type-specific vocabulary; which are required or forbidden per type is
/// enforced by program-rules.ts, not by the schema — but order uniqueness is.
model ProgramSection {
  id String @id @default(cuid())

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  name  String?
  type  WorkoutType
  order Int

  timeCapSeconds           Int?
  intervalSeconds          Int?
  rounds                   Int?
  restBetweenRoundsSeconds Int?

  exercises ProgramExercise[]

  // The array position of the payload is the only source of order; this backstop
  // guarantees no duplicates survive a write. Doubles as the ordered-read index.
  @@unique([programId, order])
}

/// One prescribed line. Prescription fields are deliberately all optional —
/// structure is validated, methodology is not legislated: a strength section
/// legitimately holds a 40-second plank. Load is either a number with a unit or
/// free text, never both (cross-validated at the boundary).
model ProgramExercise {
  id String @id @default(cuid())

  sectionId String
  section   ProgramSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Restrict settles the Step 7 contract: deleting an exercise that a program
  // still references is refused, and the endpoint maps it to a 409.
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  order Int

  sets Int?
  reps Int?

  loadValue Decimal?  @db.Decimal(6, 2)
  loadUnit  LoadUnit?
  loadText  String?

  restSeconds Int?
  tempo       String?
  notes       String?

  durationSeconds Int?
  distanceMeters  Int?

  @@unique([sectionId, order])
  @@index([exerciseId])
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// A program assigned to a client — as an independent SNAPSHOT, the invariant
/// Steps 10–11 designed toward. The tree below (AssignmentSection/-Exercise) is
/// written once in the assign transaction and has no update path at all:
/// editing or deleting the source template cannot reach it by construction.
/// `sourceProgramId` is provenance only — never read for the tree — and goes
/// NULL when the template is deleted.
///
/// Schedule is weekly recurrence: startDate, optional endDate, ISO weekdays
/// (Пн=1). Step 13's «today» is one query; Step 14 addresses an occurrence as
/// (assignmentExerciseId, date).
model Assignment {
  id String @id @default(cuid())

  trainerId String
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  sourceProgramId String?
  sourceProgram   Program? @relation(fields: [sourceProgramId], references: [id], onDelete: SetNull)

  name        String
  description String?
  type        WorkoutType

  status AssignmentStatus @default(ACTIVE)

  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  daysOfWeek Int[]

  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sections AssignmentSection[]

  @@index([trainerId])
  @@index([clientId])
}

model AssignmentSection {
  id String @id @default(cuid())

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  name  String?
  type  WorkoutType
  order Int

  timeCapSeconds           Int?
  intervalSeconds          Int?
  rounds                   Int?
  restBetweenRoundsSeconds Int?

  exercises AssignmentExercise[]

  @@unique([assignmentId, order])
}

/// One frozen prescription line. Unlike template rows, this id is durable —
/// Step 14's WorkoutLog references it as a real foreign key. The prescription
/// is snapshotted; the exercise itself stays a live library reference (name,
/// instructions, video should show the trainer's latest fixes), protected by
/// Restrict exactly like template references.
model AssignmentExercise {
  id String @id @default(cuid())

  sectionId String
  section   AssignmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  order Int

  sets Int?
  reps Int?

  loadValue Decimal?  @db.Decimal(6, 2)
  loadUnit  LoadUnit?
  loadText  String?

  restSeconds Int?
  tempo       String?
  notes       String?

  durationSeconds Int?
  distanceMeters  Int?

  @@unique([sectionId, order])
  @@index([exerciseId])
}
