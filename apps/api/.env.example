# Copy to .env and fill in. Never commit .env.
# The password must match GART_DB_PASSWORD in the repo-root .env used by docker compose.

DATABASE_URL="postgresql://gart_app:change-me-locally@localhost:15432/gart?schema=public"

# Used only by `prisma migrate dev`. Pre-created so the app role needs no CREATEDB.
SHADOW_DATABASE_URL="postgresql://gart_app:change-me-locally@localhost:15432/gart_shadow?schema=public"

# Wiped and re-migrated by the test suite. Never point this at a real database.
TEST_DATABASE_URL="postgresql://gart_app:change-me-locally@localhost:15432/gart_test?schema=public"

# Port the API listens on. Defaults to 4001 when unset.
PORT=4001

# The single origin allowed to send credentialed requests. No wildcard is
# possible with cookies, and none is wanted.
WEB_ORIGIN=http://localhost:3000

# Which environment this is. Stated rather than inferred: the payment provider
# refuses to bind its fake unless this says development or test, so an unset or
# misspelled value fails the boot instead of quietly granting free access.
NODE_ENV=development

# Where this API is reachable from the outside. A payment provider posts its
# callbacks here, so it must be the public address in production, not localhost.
API_ORIGIN=http://localhost:4001

# Which acquirer takes the money. `fake` confirms immediately and grants access
# without charging anyone, so it loads ONLY when NODE_ENV is development or
# test — anything else, including unset, needs ALLOW_FAKE_PAYMENTS=true said
# deliberately. A name with no implementation stops the boot rather than
# falling back to the fake.
PAYMENT_PROVIDER=fake

# Rate limits. The auth pair applies to /auth/register and /auth/login.
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_MS=60000
# Messages a trainer may send their clients, counted per trainer, per hour.
MESSAGE_THROTTLE_LIMIT=20
MESSAGE_THROTTLE_TTL_MS=3600000
# Chat messages per participant, per hour.
CHAT_THROTTLE_LIMIT=60
CHAT_THROTTLE_TTL_MS=3600000
# Provider callbacks. Deliberately the loosest budget here: acquirers retry, and
# several burst after an outage of their own. A dropped callback is paid access
# that never arrives, which costs more than the flood a tight limit would stop.
CALLBACK_THROTTLE_LIMIT=300
CALLBACK_THROTTLE_TTL_MS=60000

# Password for the seeded demo trainer (demo@gart.fit). Local development only.
SEED_DEMO_PASSWORD=demo12345

# S3-compatible object storage for exercise media. Dev values point at the
# MinIO container; in production use any S3-compatible provider — ideally an
# egress-free one, since every client view re-streams the clip.
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=gart-media
STORAGE_ACCESS_KEY=gart_minio
STORAGE_SECRET_KEY=change-me-locally
STORAGE_FORCE_PATH_STYLE=true

# Queue backend for notification delivery. The API starts and serves without
# it; only asynchronous web-push waits for it to come back.
REDIS_URL=redis://localhost:16379

# Web-push (VAPID). Generate a pair with:  npx web-push generate-vapid-keys
# The PRIVATE key is a secret — never commit it. The public key is served to
# the browser by GET /notifications/push/key, not baked into the web bundle.
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:trainer@gart.fit

# When the inactivity sweep runs (server time). Alerts simply resume if the
# queue was unavailable — nothing else depends on it.
INACTIVITY_SWEEP_CRON=0 9 * * *
