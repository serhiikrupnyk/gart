# Copy to .env and fill in. Never commit .env.
# The password must match GART_DB_PASSWORD in the repo-root .env used by docker compose.

DATABASE_URL="postgresql://gart_app:change-me-locally@localhost:5433/gart?schema=public"

# Used only by `prisma migrate dev`. Pre-created so the app role needs no CREATEDB.
SHADOW_DATABASE_URL="postgresql://gart_app:change-me-locally@localhost:5433/gart_shadow?schema=public"

# Port the API listens on. Defaults to 4001 when unset.
PORT=4001
