# Copy to .env before running `docker compose up -d`. Never commit .env.
# These values configure the Postgres container only — the API reads apps/api/.env.

# Superuser. Used solely by the container entrypoint to provision the app role below.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-locally

# Least-privilege role the API actually connects as, and the databases it owns.
# GART_DB_SHADOW exists so Prisma can run `migrate dev` without CREATEDB rights.
GART_DB=gart
GART_DB_SHADOW=gart_shadow
GART_DB_USER=gart_app
GART_DB_PASSWORD=change-me-locally

# Host port. 5432 is normally taken by another local Postgres.
POSTGRES_PORT=5433
